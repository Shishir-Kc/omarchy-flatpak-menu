#!/bin/bash
# omarchy:summary=Show a fuzzy-finder TUI for picking installed Flatpak apps to remove.
# omarchy:group=remove

set -euo pipefail

if ! command -v flatpak >/dev/null 2>&1; then
    echo "Error: Flatpak is not installed." >&2
    exit 1
fi

fzf_args=(
  --multi
  --preview 'flatpak info {1}'
  --preview-label='alt-p: toggle details, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:red,marker:red'
  --delimiter '\t'
  --with-nth '2,3'
  --header 'Installed Flatpak Apps | TAB=multi-select | ALT-p=preview | ENTER=remove'
)

# List installed apps: app-id \t name \t description
app_list=$(flatpak list --app --columns=application,name,description 2>/dev/null || true)

if [[ -z "$app_list" ]]; then
    echo "[INFO] No Flatpak apps installed." >&2
    exit 0
fi

selected=$(echo "$app_list" | fzf "${fzf_args[@]}")

if [[ -n "$selected" ]]; then
    # Extract app IDs (first column, tab-delimited)
    app_ids=$(echo "$selected" | cut -f1 | tr '\n' ' ')

    # Remove in floating terminal with progress
    omarchy-launch-floating-terminal-with-presentation \
      "echo 'Removing selected Flatpak apps...'; flatpak uninstall -y $app_ids; echo ''; echo 'Removal complete. Press any key to close.'; read -n 1"
    omarchy-show-done
fi
