{
  // Flatpak Removal Menu
  "remove.flatpak": {"icon": "󰏓", "label": "Flatpak Apps", "description": "Remove installed Flatpak apps"},
  "remove.flatpak.browsers": {"icon": "", "label": "Browsers"},
  "remove.flatpak.communication": {"icon": "󰭹", "label": "Communication"},
  "remove.flatpak.development": {"icon": "󰵮", "label": "Development"},
  "remove.flatpak.media": {"icon": "󰓇", "label": "Media"},
  "remove.flatpak.gaming": {"icon": "", "label": "Gaming"},
  "remove.flatpak.utilities": {"icon": "󰏓", "label": "Utilities"},
  "remove.flatpak.remove": {"icon": "󰍉", "label": "Remove Installed...", "description": "Browse and remove installed Flatpak apps (fuzzy search)", "when": "command -v flatpak >/dev/null && flatpak list --app 2>/dev/null | grep -q .", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-flatpak-remove"},
  "remove.flatpak.browsers.firefox": {"icon": "", "label": "Firefox", "description": "Remove Firefox (Flatpak)", "when": "flatpak info org.mozilla.firefox >/dev/null 2>&1", "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak uninstall -y org.mozilla.firefox'"},
  "remove.flatpak.browsers.chrome": {"icon": "", "label": "Google Chrome", "description": "Remove Google Chrome (Flatpak)", "when": "flatpak info com.google.Chrome >/dev/null 2>&1", "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak uninstall -y com.google.Chrome'"},
