{
  // Flatpak Apps launcher submenu (under Apps)
  "apps.flatpak": {"icon": "󰏓", "label": "Flatpak", "description": "Launch installed Flatpak apps"},
  "apps.flatpak.launch": {"icon": "󰍉", "label": "Launch Installed...", "description": "Browse and launch installed Flatpak apps (fuzzy search)", "when": "command -v flatpak >/dev/null && flatpak list --app 2>/dev/null | grep -q .", "action": "omarchy-flatpak-launch"},
  "apps.flatpak.firefox": {"icon": "", "label": "Firefox", "description": "Firefox (Flatpak)", "when": "flatpak info org.mozilla.firefox >/dev/null 2>&1", "action": "uwsm-app -- flatpak run org.mozilla.firefox"},
