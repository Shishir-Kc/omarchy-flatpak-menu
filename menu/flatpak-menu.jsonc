{
  // Flatpak Installation Menu
  "install.flatpak": {"icon": "[FLATPAK]", "label": "Flatpak Apps", "description": "Install applications from Flathub"},

  // Categories
  "install.flatpak.browsers": {"icon": "[WEB]", "label": "Browsers"},
  "install.flatpak.communication": {"icon": "[CHAT]", "label": "Communication"},
  "install.flatpak.development": {"icon": "[DEV]", "label": "Development"},
  "install.flatpak.media": {"icon": "[MEDIA]", "label": "Media"},
  "install.flatpak.gaming": {"icon": "[GAME]", "label": "Gaming"},
  "install.flatpak.utilities": {"icon": "[TOOLS]", "label": "Utilities"},

  // Search Entry (fzf-based)
  "install.flatpak.search": {
    "icon": "[SEARCH]",
    "label": "Search Flathub...",
    "description": "Browse and install any app from Flathub (fuzzy search)",
    "when": "command -v flatpak >/dev/null",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-flatpak-install"
  },

  // ==========================================
  // BROWSERS (6 apps)
  // ==========================================
  "install.flatpak.browsers.firefox": {
    "icon": "[FIREFOX]", "label": "Firefox", "description": "Mozilla Firefox (Flatpak)",
    "when": "command -v flatpak >/dev/null && ! flatpak info org.mozilla.firefox",
    "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak install -y flathub org.mozilla.firefox'"
  },
  "install.flatpak.browsers.chrome": {
    "icon": "[CHROME]", "label": "Google Chrome", "description": "Google Chrome (Flatpak)",
    "when": "command -v flatpak >/dev/null && ! flatpak info com.google.Chrome",
    "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak install -y flathub com.google.Chrome'"
  },
  "install.flatpak.browsers.brave": {
    "icon": "[BRAVE]", "label": "Brave Browser", "description": "Brave Browser (Flatpak)",
    "when": "command -v flatpak >/dev/null && ! flatpak info com.brave.Browser",
    "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak install -y flathub com.brave.Browser'"
  },
  "install.flatpak.browsers.edge": {
    "icon": "[EDGE]", "label": "Microsoft Edge", "description": "Microsoft Edge (Flatpak)",
    "when": "command -v flatpak >/dev/null && ! flatpak info com.microsoft.Edge",
    "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak install -y flathub com.microsoft.Edge'"
  },
  "install.flatpak.browsers.zen": {
    "icon": "[ZEN]", "label": "Zen Browser", "description": "Zen Browser (Flatpak)",
    "when": "command -v flatpak >/dev/null && ! flatpak info app.zen_browser.zen",
    "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak install -y flathub app.zen_browser.zen'"
  },
  "install.flatpak.browsers.vivaldi": {
    "icon": "[VIVALDI]", "label": "Vivaldi", "description": "Vivaldi Browser (Flatpak)",
    "when": "command -v flatpak >/dev/null && ! flatpak info com.vivaldi.Vivaldi",
    "action": "omarchy-launch-floating-terminal-with-presentation 'flatpak install -y flathub com.vivaldi.Vivaldi'"
  },

