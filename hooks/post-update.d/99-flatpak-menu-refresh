#!/bin/bash
# omarchy:summary=Refresh Flatpak menu entries after system update

# Re-append menu entries if they were removed by config refresh
if [[ -f "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc" ]]; then
    # Check if our entries exist (both install and remove)
    if ! grep -q "install.flatpak" "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc" || ! grep -q "remove.flatpak" "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"; then
        # Call the append helper
        if command -v omarchy-flatpak-menu-append >/dev/null 2>&1; then
            omarchy-flatpak-menu-append
        else
            # Fallback: re-run installer in append-only mode
            curl -fsSL "https://raw.githubusercontent.com/Shishir-Kc/omarchy-flatpak-menu/refs/heads/master/install.sh" | bash -s -- --append-only 2>/dev/null || true
        fi
    fi
fi
